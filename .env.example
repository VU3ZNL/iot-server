# copy to .env or export these variables before "npm start"
IOT_KEY=CHANGE-ME-LONG-RANDOM-KEY     # REQUIRED, same value as IOT_KEY in the base unit sketch
PORT=3000
# optional: push every NEW SOS to Telegram (create a bot with @BotFather, get your chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# optional: POST every new SOS as JSON to this URL (Zapier, Make, n8n, your own service ...)
SOS_WEBHOOK_URL=
# optional: folder for the history files (default ./data)
DATA_DIR=./data
